{
  "name": "austria-transition-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Austrian energy-transition and emissions dashboard",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4175",
    "typecheck": "vue-tsc --noEmit",
    "test:smoke": "node tools/smoke.mjs",
    "data": "cd services && .venv/Scripts/python.exe create_charts.py",
    "data:check": "cd services && .venv/Scripts/python.exe check_contract.py"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "pinia": "^4.0.3",
    "plotly.js-basic-dist-min": "^3.7.0",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/plotly.js-basic-dist-min": "^2.12.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "sass-embedded": "^1.102.0",
    "typescript": "~5.9",
    "vite": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.3.10"
  }
}
